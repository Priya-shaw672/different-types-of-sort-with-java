#include <stdio.h>

// Function to sort an array using insertion sort
void insertionSort(float arr[], int n) {
	int i;
    for ( i = 1; i < n; i++) {
        float key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}

// Function to perform bucket sort
void bucketSort(float arr[], int n) {
	int i,j;
    // Create n empty buckets
    float buckets[n][n]; // Buckets to store elements
    int bucketSizes[n];   // Array to track bucket sizes

    // Initialize bucket sizes to 0
    for ( i = 0; i < n; i++) {
        bucketSizes[i] = 0;
    }

    // Put elements into buckets
    for ( i = 0; i < n; i++) {
        int bucketIndex = (int)(arr[i] * n); // Assuming input values are in range [0, 1)
        buckets[bucketIndex][bucketSizes[bucketIndex]++] = arr[i];
    }

    // Sort each bucket and merge them back
    int index = 0;
    for (i = 0; i < n; i++) {
        if (bucketSizes[i] > 0) {
            // Sort the bucket
            insertionSort(buckets[i], bucketSizes[i]);

            // Copy the sorted bucket back to the main array
            for ( j = 0; j < bucketSizes[i]; j++) {
                arr[index++] = buckets[i][j];
            }
        }
    }
}

// Main function
int main() {
    int n,i;
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    float arr[n];
    printf("Enter the elements of the array (values in range [0, 1)): ");
    for (i = 0; i < n; i++) {
        scanf("%f", &arr[i]);
    }

    bucketSort(arr, n);

    printf("Sorted array: ");
    for ( i = 0; i < n; i++) {
        printf("%0.2f ", arr[i]);
    }
    printf("\n");

    return 0;
}
